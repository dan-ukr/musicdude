# Copy to apps/mobile/.env
# Local API on this machine (web preview / simulator):
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
# Physical phone on the same Wi-Fi: use this machine's LAN IP instead, e.g.
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.42:3000
# Hosted API:
# EXPO_PUBLIC_API_BASE_URL=https://musicdude-api.onrender.com
