{
  "name": "musicdude",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "init-db": "node scripts/init-db.js",
    "build": "npm run build:shared && npm run build -w @musicdude/api && npm run build -w @musicdude/worker",
    "build:shared": "tsc -p packages/shared/tsconfig.json",
    "docker:up": "docker compose -f docker/docker-compose.dev.yml up --build",
    "docker:down": "docker compose -f docker/docker-compose.dev.yml down",
    "docker:infra": "docker compose -f docker/docker-compose.dev.yml up -d db redis ml",
    "api:dev": "cd apps/api && npx prisma generate && npm run start:dev",
    "worker:dev": "npm run dev -w @musicdude/worker",
    "ml:dev": "cd apps/ml-service && python -m uvicorn main:app --port 8000 --reload",
    "mobile:start": "npm run start -w @musicdude/mobile"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "dotenv": "^16.4.5",
    "pg": "^8.11.0",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=20.19"
  }
}
