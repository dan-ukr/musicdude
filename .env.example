# Local development only. The repo is public: never commit a real .env —
# production values live in the Render dashboard (see render.yaml).
#
# --- API / Worker ---
# Local docker:
DATABASE_URL=postgresql://app:app@localhost:15432/app
# Supabase: use the SESSION POOLER URI, percent-encoding any special characters
# in the password. The direct host db.<ref>.supabase.co has no IPv4 record and
# is unreachable from Render.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
REDIS_URL=redis://localhost:6379
# Upstash/Render Key Value use TLS: rediss://default:<token>@<host>:6379
JWT_SECRET=change_me_dev_only
API_PORT=3000
CORS_ALLOWED_ORIGINS=*

# --- ML engine (all-in-one; ML_ENGINE_URL is the dormant HF escape hatch) ---
ML_BASE_URL=http://localhost:8000
# ML_ENGINE_URL=

# --- Spotify: DORMANT. No credentials exist; search runs on Deezer/iTunes (keyless).
# --- These only ever activate if a Spotify app + user OAuth becomes available. ---
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=

# --- Events providers (optional in local dev) ---
# TICKETMASTER_API_KEY=
# BANDSINTOWN_APP_ID=

# --- Mobile (apps/mobile/.env) ---
# EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
